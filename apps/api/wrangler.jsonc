{
  // Preppal API — Hono on Cloudflare Workers. Not publicly routed:
  // the web and admin Workers call it through service bindings at /api/*.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "preppal-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "preppal-db",
      // Replace after `wrangler d1 create preppal-db` (see docs/DEPLOY.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "preppal-images" }],
  "vars": {
    "ENVIRONMENT": "production",
    // Cloudflare Access (Zero Trust) for the admin app — see docs/DEPLOY.md
    "ACCESS_TEAM_DOMAIN": "https://YOUR-TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "ALERT_FROM_EMAIL": "Preppal Orders <orders@REPLACE-DOMAIN>",
    "PUBLIC_SITE_URL": "https://REPLACE-DOMAIN"
  }
  // Secrets (wrangler secret put …): RESEND_API_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
}
